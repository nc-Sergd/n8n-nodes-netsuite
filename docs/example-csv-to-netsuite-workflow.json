{
	"name": "CSV → NetSuite customers and sales orders → CSV log",
	"nodes": [
		{
			"parameters": {
				"rule": {
					"interval": [
						{
							"field": "hours",
							"hoursInterval": 1
						}
					]
				}
			},
			"id": "22222222-0000-4000-8000-000000000001",
			"name": "Every Hour",
			"type": "n8n-nodes-base.scheduleTrigger",
			"typeVersion": 1.4,
			"position": [-1040, 300]
		},
		{
			"parameters": {
				"fileSelector": "C:/Users/sergeid/Documents/Examples_n8n/transactions-in.csv",
				"options": {}
			},
			"id": "22222222-0000-4000-8000-000000000002",
			"name": "Read Source CSV",
			"type": "n8n-nodes-base.readWriteFile",
			"typeVersion": 1.1,
			"position": [-820, 300],
			"notes": "Forward slashes only — fileSelector goes through glob, where a backslash is an escape. The path must also be one this n8n instance is allowed to read; the repo checkout is not, it answers 'Access to the file is not allowed.'"
		},
		{
			"parameters": {
				"operation": "csv",
				"options": {}
			},
			"id": "22222222-0000-4000-8000-000000000003",
			"name": "Parse CSV",
			"type": "n8n-nodes-base.extractFromFile",
			"typeVersion": 1.1,
			"position": [-600, 300]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "n1",
							"name": "customerExternalId",
							"value": "={{ $json.customerExternalId }}",
							"type": "string"
						},
						{
							"id": "n2",
							"name": "companyName",
							"value": "={{ $json.companyName }}",
							"type": "string"
						},
						{
							"id": "n3",
							"name": "email",
							"value": "={{ $json.email }}",
							"type": "string"
						},
						{
							"id": "n4",
							"name": "subsidiary",
							"value": "={{ $json.subsidiary }}",
							"type": "string"
						},
						{
							"id": "n5",
							"name": "orderExternalId",
							"value": "={{ $json.orderExternalId }}",
							"type": "string"
						},
						{
							"id": "n6",
							"name": "orderDate",
							"value": "={{ $json.orderDate }}",
							"type": "string"
						},
						{
							"id": "n7",
							"name": "itemId",
							"value": "={{ $json.itemId }}",
							"type": "string"
						},
						{
							"id": "n8",
							"name": "quantity",
							"value": "={{ Number($json.quantity) }}",
							"type": "number"
						},
						{
							"id": "n9",
							"name": "rate",
							"value": "={{ Number($json.rate) }}",
							"type": "number"
						},
						{
							"id": "n10",
							"name": "memo",
							"value": "={{ $json.memo }}",
							"type": "string"
						}
					]
				},
				"includeOtherFields": false,
				"options": {}
			},
			"id": "22222222-0000-4000-8000-000000000004",
			"name": "Normalize Row",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [-380, 300]
		},
		{
			"parameters": {
				"authentication": "oAuth2",
				"resource": "customer",
				"operation": "get",
				"id": "=eid:{{ $json.customerExternalId }}"
			},
			"id": "22222222-0000-4000-8000-000000000005",
			"name": "Find Customer",
			"type": "CUSTOM.netSuite",
			"typeVersion": 1,
			"position": [-160, 300],
			"onError": "continueRegularOutput",
			"alwaysOutputData": true,
			"notes": "Probe only. NetSuite accepts eid:{externalId} in place of an internal ID. A record back means the upsert below will update; a 404 means it will create. Errors are passed through, not thrown.",
			"credentials": {
				"netSuiteOAuth2Api": {
					"id": "IaPpQeUe6AM11XYW",
					"name": "NetSuite OAuth 2.0 (Client Credentials) account"
				}
			}
		},
		{
			"parameters": {
				"authentication": "oAuth2",
				"resource": "customer",
				"operation": "upsert",
				"externalId": "={{ $('Normalize Row').item.json.customerExternalId }}",
				"jsonParameters": true,
				"bodyJson": "={\n  \"companyName\": \"{{ $('Normalize Row').item.json.companyName }}\",\n  \"email\": \"{{ $('Normalize Row').item.json.email }}\",\n  \"subsidiary\": { \"id\": \"{{ $('Normalize Row').item.json.subsidiary }}\" },\n  \"isPerson\": false\n}"
			},
			"id": "22222222-0000-4000-8000-000000000006",
			"name": "Upsert Customer",
			"type": "CUSTOM.netSuite",
			"typeVersion": 1,
			"position": [60, 300],
			"onError": "continueRegularOutput",
			"credentials": {
				"netSuiteOAuth2Api": {
					"id": "IaPpQeUe6AM11XYW",
					"name": "NetSuite OAuth 2.0 (Client Credentials) account"
				}
			}
		},
		{
			"parameters": {
				"authentication": "oAuth2",
				"resource": "salesOrder",
				"operation": "get",
				"id": "=eid:{{ $('Normalize Row').item.json.orderExternalId }}"
			},
			"id": "22222222-0000-4000-8000-000000000007",
			"name": "Find Sales Order",
			"type": "CUSTOM.netSuite",
			"typeVersion": 1,
			"position": [280, 300],
			"onError": "continueRegularOutput",
			"alwaysOutputData": true,
			"notes": "Same probe as Find Customer, for the transaction. Its only job is to decide created vs updated in the log.",
			"credentials": {
				"netSuiteOAuth2Api": {
					"id": "IaPpQeUe6AM11XYW",
					"name": "NetSuite OAuth 2.0 (Client Credentials) account"
				}
			}
		},
		{
			"parameters": {
				"authentication": "oAuth2",
				"resource": "salesOrder",
				"operation": "upsert",
				"externalId": "={{ $('Normalize Row').item.json.orderExternalId }}",
				"jsonParameters": true,
				"bodyJson": "={\n  \"entity\": { \"id\": \"{{ $('Upsert Customer').item.json.id }}\" },\n  \"tranDate\": \"{{ $('Normalize Row').item.json.orderDate }}\",\n  \"memo\": \"{{ $('Normalize Row').item.json.memo }}\",\n  \"item\": { \"items\": [ {\n    \"item\": { \"id\": \"{{ $('Normalize Row').item.json.itemId }}\" },\n    \"quantity\": {{ $('Normalize Row').item.json.quantity }},\n    \"rate\": {{ $('Normalize Row').item.json.rate }}\n  } ] }\n}"
			},
			"id": "22222222-0000-4000-8000-000000000008",
			"name": "Upsert Sales Order",
			"type": "CUSTOM.netSuite",
			"typeVersion": 1,
			"position": [500, 300],
			"onError": "continueRegularOutput",
			"credentials": {
				"netSuiteOAuth2Api": {
					"id": "IaPpQeUe6AM11XYW",
					"name": "NetSuite OAuth 2.0 (Client Credentials) account"
				}
			}
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "l1",
							"name": "runAt",
							"value": "={{ $now.toISO() }}",
							"type": "string"
						},
						{
							"id": "l2",
							"name": "customerExternalId",
							"value": "={{ $('Normalize Row').item.json.customerExternalId }}",
							"type": "string"
						},
						{
							"id": "l3",
							"name": "customerInternalId",
							"value": "={{ $('Upsert Customer').item.json.id }}",
							"type": "string"
						},
						{
							"id": "l4",
							"name": "customerAction",
							"value": "={{ $('Find Customer').item.json.id ? 'updated' : 'created' }}",
							"type": "string"
						},
						{
							"id": "l5",
							"name": "orderExternalId",
							"value": "={{ $('Normalize Row').item.json.orderExternalId }}",
							"type": "string"
						},
						{
							"id": "l6",
							"name": "orderInternalId",
							"value": "={{ $json.id }}",
							"type": "string"
						},
						{
							"id": "l7",
							"name": "orderAction",
							"value": "={{ $('Find Sales Order').item.json.id ? 'updated' : 'created' }}",
							"type": "string"
						},
						{
							"id": "l8",
							"name": "status",
							"value": "={{ $json.error ? 'failed' : 'ok' }}",
							"type": "string"
						},
						{
							"id": "l9",
							"name": "error",
							"value": "={{ $json.error || '' }}",
							"type": "string"
						}
					]
				},
				"includeOtherFields": false,
				"options": {}
			},
			"id": "22222222-0000-4000-8000-000000000009",
			"name": "Build Log Row",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [720, 300]
		},
		{
			"parameters": {
				"operation": "csv",
				"options": {
					"fileName": "netsuite-sync-log.csv"
				}
			},
			"id": "22222222-0000-4000-8000-00000000000a",
			"name": "To CSV",
			"type": "n8n-nodes-base.convertToFile",
			"typeVersion": 1.1,
			"position": [940, 300]
		},
		{
			"parameters": {
				"operation": "write",
				"fileName": "=C:/Users/sergeid/Documents/Examples_n8n/netsuite-sync-{{ $now.toFormat('yyyyLLdd-HHmmss') }}.csv",
				"options": {}
			},
			"id": "22222222-0000-4000-8000-00000000000b",
			"name": "Write Log CSV",
			"type": "n8n-nodes-base.readWriteFile",
			"typeVersion": 1.1,
			"position": [1160, 300]
		}
	],
	"connections": {
		"Every Hour": { "main": [[{ "node": "Read Source CSV", "type": "main", "index": 0 }]] },
		"Read Source CSV": { "main": [[{ "node": "Parse CSV", "type": "main", "index": 0 }]] },
		"Parse CSV": { "main": [[{ "node": "Normalize Row", "type": "main", "index": 0 }]] },
		"Normalize Row": { "main": [[{ "node": "Find Customer", "type": "main", "index": 0 }]] },
		"Find Customer": { "main": [[{ "node": "Upsert Customer", "type": "main", "index": 0 }]] },
		"Upsert Customer": { "main": [[{ "node": "Find Sales Order", "type": "main", "index": 0 }]] },
		"Find Sales Order": { "main": [[{ "node": "Upsert Sales Order", "type": "main", "index": 0 }]] },
		"Upsert Sales Order": { "main": [[{ "node": "Build Log Row", "type": "main", "index": 0 }]] },
		"Build Log Row": { "main": [[{ "node": "To CSV", "type": "main", "index": 0 }]] },
		"To CSV": { "main": [[{ "node": "Write Log CSV", "type": "main", "index": 0 }]] }
	},
	"pinData": {}
}
